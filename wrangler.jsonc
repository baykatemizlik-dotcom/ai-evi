{
  "name": "ai-evi",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "vars": {
    "OPENAI_MODEL": "gpt-4o-mini",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "ALLOWED_ORIGIN": "https://baykatemizlik-dotcom.github.io",
    "NEWS_AI_ENABLED": "false",
    "NEWS_CANDIDATE_RANKER_ENABLED": "true",
    "NEWS_WAVE_GEMINI_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-evi-v05-test",
      "database_id": "08339ed0-2dfc-49d1-a4a4-52552ae25966"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PANEL_ARCHIVE",
      "id": "28b97d6f1fca4122a0c617d4829631a7"
    }
  ],
  "triggers": {
    "crons": [
      "* 6-16 * * 1-5",
      "30 16 * * *",
      "30 20 * * *",
      "15 6 * * *",
      "*/15 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EDGE_LIVE",
        "class_name": "EdgeLiveHub"
      }
    ]
  }
}
