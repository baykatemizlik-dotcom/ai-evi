{
  "name": "ai-evi",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "vars": {
    "OPENAI_MODEL": "gpt-4o-mini",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "ALLOWED_ORIGIN": "https://baykatemizlik-dotcom.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-evi-v05-test",
      "database_id": "08339ed0-2dfc-49d1-a4a4-52552ae25966"
    }
  ],
  "triggers": {
    "crons": [
      "* 6-16 * * 1-5"
    ]
  },
  "observability": {
    "enabled": true
  }
}
